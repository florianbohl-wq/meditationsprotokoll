{
  "name": "meditationsprotokoll",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Meditationsprotokoll – lokales Übungstagebuch als PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:laptop": "tsc --noEmit && vite build --mode laptop && vite preview --open",
    "test:handy": "tsc --noEmit && vite build --mode laptop && vite preview --host",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.2",
    "workbox-window": "^7.3.0"
  }
}
